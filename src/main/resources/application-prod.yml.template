# ═══════ Zincoid's 部署配置文件 ═══════ #
# 注: 用户使用 部署修改配置使用此配置文件.
# ════════════════════════════════════ #

zincoid:

  # ────── 网站配置 ───────────────── #
  site:
    name: Zincoid's              # 网站名称
    url: https://zincoid.online  # 网站地址

  # ────── 数据存储 ───────────────── #
  database:
    url: jdbc:mysql://localhost:3306/zincoid  # 数据库地址
    username: root               # 数据库用户名
    password:                    # 数据库密码

  # ────── 身份验证 ───────────────── #
  jwt:
    secret:                      # JWT 密钥
    expiration: 604800           # JWT 过期时间 (单位: 秒)
  cookie:
    secure: true                 # Cookie 仅限 HTTPS
    same-site: None              # Cookie 跨站策略
    max-age: 604800              # Cookie 最大年龄 (单位: 秒)

  # ────── 邮件服务 ───────────────── #
  mail:
    host: smtp.qq.com            # SMTP 服务器
    port: 465                    # SMTP 端口
    username: your-email@qq.com  # 发件邮箱
    password: smtp-auth-code     # SMTP 授权码

  # ────── 文件上传 ───────────────── #
  upload:
    path: ./files                # 文件路径
    max-size: 521MB              # 文件限制
    thumb-max-size: 512          # 缩略图限制

  # ────── 日志记录 ───────────────── #
  logging:
    level: INFO                  # 日志级别
    path: ./output.log           # 日志路径

  # ────── GitHub ────────────────── #
  github:
    token:                       # GitHub 令牌
